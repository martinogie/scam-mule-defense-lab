# Copy this file to .env (git-ignored) and fill in your own values:
#   cp .env.example .env
# Never commit .env. Each machine has its own: your PC (dev) and the Oracle VM (prod).

# --- Which environment this machine is: dev, ci or prod (no default; see common/environment.py)
SCAM_MULE_ENV=dev

# --- Docker Compose: on your PC, a plain `docker compose ...` then means the DEV stack.
# (Windows uses ";" between files. On Linux/macOS use ":" instead.)
# On the prod VM, delete these two lines: docker-compose.yaml alone is prod.
COMPOSE_FILE=docker-compose.yaml;docker-compose.dev.yaml
COMPOSE_PROJECT_NAME=scam-mule-dev

# --- Secrets: choose your own long random values. Prod refuses placeholders like "change-me".
# A quick way to make one: uv run python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
